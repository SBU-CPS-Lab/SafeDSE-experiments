diff -ruN a/model/dse.mzn b/model/dse.mzn
--- a/model/dse.mzn
+++ b/model/dse.mzn
@@ -107,9 +107,37 @@
 array[A] of var 1..maxmu: mu_of;
 constraint forall(i in A)( mu_of[i] = mu[app[i]] );
 
-constraint mcm_fixed_edges(tok, T, pot, mu_of);
-constraint mcm_schedule_edges(sedge, T, pot);
-constraint mcm_wrap_edges(wrap, T, pot, mu_of);
+% Two potentials per node. An inactive slot has
+% T = 0 but keeps its place in its core's static order; if channel edges and
+% order edges met at its potential, a channel into the slot followed by an
+% order edge out of it would be a path that the deployed design does not have,
+% and the least period of a fixed design could exceed its real MCR (146 vs
+% 139). So channels use `pot` and the static order and wrap edges use `qpot`,
+% and the two coincide on every active node: an inactive node passes the order
+% on (T = 0, which splices the order around it) without joining its channels
+% to it. Channel edges stay unconditional linear inequalities.
+array[A] of var -maxmu..maxmu: qpot;
+constraint forall(i in A where forall(p in PAT)(node_guard[i, p]))(
+    qpot[i] = pot[i] );
+constraint forall(i in A where not forall(p in PAT)(node_guard[i, p]))(
+    active[i] -> qpot[i] = pot[i] );
+% A pattern channel whose endpoints can both be active under a pattern that
+% does not select it (a slot shared between patterns, or a second guard) is
+% posted only under its own guard, pe_on (mcm_pattern_edges); every other
+% channel is posted from `tok`. Self-loops of slots stay in `tok`.
+array[int] of bool: pe_needs_guard = [
+    exists(p in PAT)( not pe_guard2[e, p] ) \/
+    exists(p in PAT)( node_guard[pe_src[e], p] /\ node_guard[pe_dst[e], p]
+                      /\ not pe_guard[e, p] )
+    | e in PE ];
+set of int: pe_pairs = { (pe_src[e] - 1) * card(A) + pe_dst[e]
+                       | e in PE where pe_needs_guard[e] };
+array[A, A] of int: tok_fixed = array2d(A, A,
+    [ if i != j /\ (i - 1) * card(A) + j in pe_pairs then -1 else tok[i, j] endif
+    | i, j in A ]);
+constraint mcm_fixed_edges(tok_fixed, T, pot, mu_of);
+constraint mcm_schedule_edges(sedge, T, qpot);
+constraint mcm_wrap_edges(wrap, T, qpot, mu_of);
 constraint mcm_pattern_edges(T, pot, mu_of);
 constraint comm_msag_edges(T, pot, mu_of);
 constraint mcm_anchor(pot);
